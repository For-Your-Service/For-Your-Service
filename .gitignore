# Resume Privacy - Never commit personal resumes
data/resumes/*.pdf
data/resumes/*.docx
data/resumes/*.doc
results/*.json

# Keep directory structure
!data/resumes/.gitkeep
!results/.gitkeep

# API Credentials - NEVER commit these!
config/api_credentials.py
.env
*.key
*_credentials.py

# Terraform
*.tfstate
*.tfstate.*
