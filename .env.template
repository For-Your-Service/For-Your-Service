# For Your Service - Environment Variables Template
# Copy this to .env and fill in your values

# Databricks Configuration
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi_your_token_here

# Database Configuration
CATALOG_NAME=veteran_intake
BRONZE_SCHEMA=bronze
SILVER_SCHEMA=silver
GOLD_SCHEMA=gold

# API Keys (store in Databricks Secrets in production)
INDEED_API_KEY=your_indeed_api_key
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
MONSTER_API_KEY=your_monster_api_key
CAREERBUILDER_API_KEY=your_careerbuilder_api_key
ZIPRECRUITER_API_KEY=your_ziprecruiter_api_key
USAJOBS_EMAIL=your_email_for_usajobs_api

# Model Configuration
MODEL_PATH=models/
EMBEDDING_DIMENSION=384
TOP_N_MATCHES=10
SIMILARITY_THRESHOLD=0.5

# Deployment Configuration
ENVIRONMENT=development  # development, staging, production
LOG_LEVEL=INFO
