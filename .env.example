# For Your Service - API Configuration Template
# Copy to .env and fill in your actual credentials
# DO NOT commit .env to Git!

# ============================================
# USAJOBS API Configuration
# ============================================
# Register at: https://developer.usajobs.gov/
USAJOBS_API_KEY=your_usajobs_api_key_here
USAJOBS_USER_AGENT=your_email@example.com

# ============================================
# JSearch API (RapidAPI) Configuration
# ============================================
# Get key at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_RAPIDAPI_KEY=your_rapidapi_key_here

# ============================================
# Adzuna API Configuration
# ============================================
# Register at: https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# ============================================
# Databricks Configuration
# ============================================
DATABRICKS_SERVER_HOSTNAME=dbc-3e95d032-684c.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your_warehouse_id
DATABRICKS_TOKEN=dapi_your_token_here

# ============================================
# Regional Configuration
# ============================================
TARGET_LOCATION=Greenville, SC
SEARCH_RADIUS_MILES=50
TARGET_MSA=Greenville-Anderson
