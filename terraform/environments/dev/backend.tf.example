# File: terraform/environments/dev/backend.tf.example
# Description: Example Remote State Backend for Dev Environment

terraform {
  backend "s3" {
    bucket         = "foryourservice-tfstate-dev"
    key            = "environments/dev/terraform.tfstate"
    region         = "us-east-1"
    dynamodb_table = "foryourservice-tflocks-dev"
    encrypt        = true
  }
}
